# SecureVault backend environment variables
# Copy this file to .env for local overrides (optional, defaults work out of the box).

# Port the server listens on.
# Railway and Render set this automatically; leave unset for local development.
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
# Development default is set in main.py (localhost:5173).
# Production: set this to your deployed Vercel URL, e.g.:
#   CORS_ORIGINS=https://securevault.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
